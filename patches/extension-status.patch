 /** Extra column reserved at the right edge to absorb font quirks. */
 const SAFETY_MARGIN = 1;
 
+/** Optional third line for setStatus() plugins; preserve their ANSI styling. */
+export function formatExtensionStatusLine(
+	statuses: ReadonlyMap<string, string>,
+	width: number,
+): string | null {
+	if (width <= 0) return null;
+	const text = Array.from(statuses.entries())
+		.sort(([a], [b]) => a.localeCompare(b))
+		.map(([, value]) => value.replace(/[\r\n\t]/g, " ").replace(/ +/g, " ").trim())
+		.filter(Boolean)
+		.join("  ");
+	return text ? truncateSafe(text, Math.max(0, width - SAFETY_MARGIN), "") : null;
+}
